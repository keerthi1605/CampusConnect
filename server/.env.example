PORT=5000
# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017 for a local mongod)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database to use (overrides any database name in MONGO_URI)
DB_NAME=campusconnect
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Used only by `npm run seed:admin` (admins cannot self-register)
ADMIN_NAME=Placement Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# Used only by `npm run seed:demo` (demo students, jobs and applications for walkthroughs).
# Pick any password; it is not committed. Demo accounts use @campusconnect.test addresses.
# DEMO_PASSWORD=

# --- Hardening (all optional; sensible defaults are built in) ---
# Behind a hosting proxy (Render, Railway, ...) set this to the number of proxies (usually 1)
# so rate limits apply per visitor instead of to the proxy. Leave unset when not proxied.
# TRUST_PROXY=1
# Largest JSON request body accepted (default 20kb)
# BODY_LIMIT=20kb
# Rate limits. Windows are fixed: 15 minutes for the API and sign-in, 1 hour for registration.
# RATE_LIMIT_API_MAX=600      requests per IP per 15 min
# AUTH_LOGIN_MAX=5            failed sign-ins per IP + email per 15 min
# AUTH_LOGIN_IP_MAX=100       failed sign-ins per IP per 15 min (all accounts)
# AUTH_REGISTER_MAX=30        sign-ups per IP per hour
# bcrypt cost for new passwords (default 12; tests use 4)
# BCRYPT_ROUNDS=12
